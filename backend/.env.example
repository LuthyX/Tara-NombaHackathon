# ─────────────────────────────────────────────────────────────────────────────
# TARA — Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit your real .env file to git
# ─────────────────────────────────────────────────────────────────────────────

# ── App Settings ──────────────────────────────────────────────────────────────
APP_NAME=Tara
APP_ENV=development

# A long random string used to sign JWT tokens — change this in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this

# How long (in minutes) before an access token expires — 15 mins is standard
ACCESS_TOKEN_EXPIRE_MINUTES=15

# How long (in days) before a refresh token expires
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Supabase / PostgreSQL ─────────────────────────────────────────────────────
# Get this from your Supabase project → Settings → Database → Connection string
# Use the "URI" format (starts with postgresql://)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# Get these from your Upstash dashboard after creating a Redis database
UPSTASH_REDIS_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-token

# ── Nomba Sandbox Credentials ─────────────────────────────────────────────────
# IMPORTANT: Use SANDBOX credentials + SANDBOX base URL during development
# The sandbox base URL is different from production — they must always be paired
NOMBA_BASE_URL=https://sandbox.nomba.com/v1

# Parent account ID — from the Nomba credentials email (the "Main Account ID")
# This goes into the 'accountId' HEADER on every API request
NOMBA_PARENT_ACCOUNT_ID=your-parent-account-id

# Sub-account ID — from the Nomba credentials email (your "sub-account ID")
# Used to scope virtual account creation to your specific account
NOMBA_SUB_ACCOUNT_ID=your-sub-account-id

# TEST client credentials (from the credentials email under "TEST credentials")
NOMBA_CLIENT_ID=your-test-client-id
NOMBA_CLIENT_SECRET=your-test-private-key

# Webhook secret — Nomba uses this to sign webhook payloads
# You'll get this when you submit your webhook URL to Nomba
NOMBA_WEBHOOK_SECRET=your-webhook-secret

# ── CORS ──────────────────────────────────────────────────────────────────────
# The URL of our React frontend — FastAPI needs to allow requests from here
# During development this is localhost:5173 (Vite's default port)
FRONTEND_URL=http://localhost:5173
